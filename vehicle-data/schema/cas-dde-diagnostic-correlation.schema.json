{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bmw-e9x-remote-control.invalid/vehicle-data/schema/cas-dde-diagnostic-correlation.schema.json",
  "title": "Phase 3D sequential CAS/DDE diagnostic correlation evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_type", "session_id", "observation_id", "profile_ref", "evidence_index",
    "evidence_ref", "source", "source_payload_sha256", "classification_model", "recovery", "critical_samples",
    "transition_bounds", "call_aware_transition_bounds", "observed_kl50_duration_bounds_ms",
    "conservative_call_aware_kl50_duration_bounds_ms", "diagnostic_correlation",
    "stabilized_rpm_summary", "qualification", "physical_transition_order",
    "rpm_alignment_status", "forbidden_inferences", "notes"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_type": {"const": "CAS_DDE_DIAGNOSTIC_CORRELATION_OBSERVATION"},
    "session_id": {"const": "OEM_START_SYNC_01"},
    "observation_id": {"type": "string", "minLength": 1},
    "profile_ref": {"type": "string", "minLength": 1},
    "evidence_index": {"type": "string", "minLength": 1},
    "evidence_ref": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "process_count", "session_count", "clock", "acquisition_order", "cas", "dde", "captured_at", "read_only"],
      "properties": {
        "tool": {"const": "TestO 2.0"},
        "process_count": {"const": 1},
        "session_count": {"const": 1},
        "clock": {"const": "Date.now() milliseconds"},
        "acquisition_order": {"const": ["CAS", "DDE"]},
        "cas": {"$ref": "#/$defs/sourceSignal"},
        "dde": {"$ref": "#/$defs/sourceSignal"},
        "captured_at": {"type": "string", "format": "date-time"},
        "read_only": {"const": true}
      }
    },
    "source_payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "classification_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["diagnostic_values", "klemmenstatus_bit_decode", "kl50_rpm_relation", "diagnostic_sequence", "physical_transition_order"],
      "properties": {
        "diagnostic_values": {"const": "RAW_OBSERVED"},
        "klemmenstatus_bit_decode": {"const": "DERIVED_FROM_DOCUMENTED_BITS"},
        "kl50_rpm_relation": {"const": "CORRELATED"},
        "diagnostic_sequence": {"const": "CONFIRMED"},
        "physical_transition_order": {"const": "UNKNOWN"}
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declared_samples", "recovered_samples", "missing_samples", "duplicate_samples", "all_recovered_reads_ok", "full_raw_file_in_repository", "raw_excerpt_in_repository"],
      "properties": {
        "declared_samples": {"type": "integer", "minimum": 1},
        "recovered_samples": {"type": "integer", "minimum": 1},
        "missing_samples": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
        "duplicate_samples": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
        "all_recovered_reads_ok": {"type": "boolean"},
        "full_raw_file_in_repository": {"type": "boolean"},
        "raw_excerpt_in_repository": {"type": "boolean"}
      }
    },
    "critical_samples": {"type": "array", "minItems": 5, "items": {"$ref": "#/$defs/sample"}},
    "transition_bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kl50_on", "rpm_nonzero", "kl50_off"],
      "properties": {
        "kl50_on": {"$ref": "#/$defs/transitionBound"},
        "rpm_nonzero": {"$ref": "#/$defs/transitionBound"},
        "kl50_off": {"$ref": "#/$defs/transitionBound"}
      }
    },
    "call_aware_transition_bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kl50_on", "rpm_nonzero", "kl50_off"],
      "properties": {
        "kl50_on": {"$ref": "#/$defs/casCallBound"},
        "rpm_nonzero": {"$ref": "#/$defs/ddeCallBound"},
        "kl50_off": {"$ref": "#/$defs/casCallBound"}
      }
    },
    "observed_kl50_duration_bounds_ms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum", "exact_physical_duration", "status"],
      "properties": {
        "minimum": {"type": "integer", "minimum": 0},
        "maximum": {"type": "integer", "minimum": 0},
        "exact_physical_duration": {"type": "null"},
        "status": {"const": "OBSERVED_BOUNDED_DIAGNOSTIC_SAMPLING"}
      }
    },
    "conservative_call_aware_kl50_duration_bounds_ms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum", "exact_physical_duration", "status"],
      "properties": {
        "minimum": {"type": "integer", "minimum": 0},
        "maximum": {"type": "integer", "minimum": 0},
        "exact_physical_duration": {"type": "null"},
        "status": {"const": "OBSERVED_BOUNDED_SEQUENTIAL_CALLS"}
      }
    },
    "diagnostic_correlation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["same_clock", "same_process", "same_ediabas_session", "cas_then_dde_sequential", "first_on_to_first_nonzero_read_gap_ms", "last_on_to_863_rpm_read_gap_ms", "first_off_to_981_5_rpm_read_gap_ms"],
      "properties": {
        "same_clock": {"const": true},
        "same_process": {"const": true},
        "same_ediabas_session": {"const": true},
        "cas_then_dde_sequential": {"const": true},
        "first_on_to_first_nonzero_read_gap_ms": {"type": "integer", "minimum": 0},
        "last_on_to_863_rpm_read_gap_ms": {"type": "integer", "minimum": 0},
        "first_off_to_981_5_rpm_read_gap_ms": {"type": "integer", "minimum": 0}
      }
    },
    "stabilized_rpm_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_range", "recovered_sample_count", "minimum", "median", "mean", "maximum", "unit"],
      "properties": {
        "sample_range": {"const": [19, 299]},
        "recovered_sample_count": {"type": "integer", "minimum": 1},
        "minimum": {"type": "number", "minimum": 0},
        "median": {"type": "number", "minimum": 0},
        "mean": {"type": "number", "minimum": 0},
        "maximum": {"type": "number", "minimum": 0},
        "unit": {"const": "rpm"}
      }
    },
    "qualification": {"const": "CONFIRMED_DIAGNOSTIC_CORRELATION"},
    "physical_transition_order": {"const": "UNKNOWN"},
    "rpm_alignment_status": {"const": "OBSERVED_BOUNDED"},
    "forbidden_inferences": {
      "type": "array", "uniqueItems": true,
      "items": {"enum": ["EXACT_PHYSICAL_KL50_ON_TIME", "EXACT_PHYSICAL_KL50_OFF_TIME", "PHYSICAL_KL50_VS_RPM_ORDER", "CAN_IDENTIFIER", "CAN_PAYLOAD", "CAS_COMMAND", "DDE_COMMAND", "KL50_COMMAND", "TRANSMISSION_PATH", "IMMOBILIZER_BYPASS", "REMOTE_START_ACTUATION", "OEM_START_REQUEST", "OEM_START_AUTHORIZATION", "FINAL_ENGINE_RUNNING_ALGORITHM"]}
    },
    "notes": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "sourceSignal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sgbd_prg", "job", "field"],
      "properties": {
        "sgbd_prg": {"type": "string", "minLength": 1},
        "job": {"type": "string", "minLength": 1},
        "field": {"type": "string", "minLength": 1}
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample", "cas_timestamp_ms", "klemmenstatus_decimal", "klemmenstatus_hex", "kl50_interpretation", "dde_timestamp_ms", "rpm", "end_timestamp_ms", "cas_ok", "dde_ok"],
      "properties": {
        "sample": {"type": "integer", "minimum": 0},
        "cas_timestamp_ms": {"type": "integer", "minimum": 0},
        "klemmenstatus_decimal": {"enum": [69, 85]},
        "klemmenstatus_hex": {"enum": ["0x45", "0x55"]},
        "kl50_interpretation": {"enum": ["KL50_OFF", "KL50_ON"]},
        "dde_timestamp_ms": {"type": "integer", "minimum": 0},
        "rpm": {"type": "number", "minimum": 0},
        "end_timestamp_ms": {"type": "integer", "minimum": 0},
        "cas_ok": {"const": true},
        "dde_ok": {"const": true}
      }
    },
    "transitionBound": {
      "type": "object",
      "additionalProperties": false,
      "required": ["after_timestamp_ms_exclusive", "by_timestamp_ms_inclusive", "window_ms", "physical_instant_known"],
      "properties": {
        "after_timestamp_ms_exclusive": {"type": "integer", "minimum": 0},
        "by_timestamp_ms_inclusive": {"type": "integer", "minimum": 0},
        "window_ms": {"type": "integer", "minimum": 0},
        "physical_instant_known": {"const": false}
      }
    },
    "casCallBound": {
      "type": "object",
      "additionalProperties": false,
      "required": ["after_prior_call_start_ms_exclusive", "by_first_new_call_end_ms_inclusive", "window_ms", "physical_instant_known"],
      "properties": {
        "after_prior_call_start_ms_exclusive": {"type": "integer", "minimum": 0},
        "by_first_new_call_end_ms_inclusive": {"type": "integer", "minimum": 0},
        "window_ms": {"type": "integer", "minimum": 0},
        "physical_instant_known": {"const": false}
      }
    },
    "ddeCallBound": {
      "type": "object",
      "additionalProperties": false,
      "required": ["after_prior_dde_call_start_ms_exclusive", "by_first_nonzero_dde_call_end_ms_inclusive", "window_ms", "physical_instant_known"],
      "properties": {
        "after_prior_dde_call_start_ms_exclusive": {"type": "integer", "minimum": 0},
        "by_first_nonzero_dde_call_end_ms_inclusive": {"type": "integer", "minimum": 0},
        "window_ms": {"type": "integer", "minimum": 0},
        "physical_instant_known": {"const": false}
      }
    }
  }
}
