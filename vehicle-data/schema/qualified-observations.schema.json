{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bmw-e9x-remote-control.invalid/vehicle-data/schema/qualified-observations.schema.json",
  "title": "Phase 3D qualified real observations",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_id", "example_only", "profile_ref", "evidence_index", "recorded_at", "observations"],
  "properties": {
    "schema_version": {"const": 1},
    "bundle_id": {"type": "string", "minLength": 1, "maxLength": 96},
    "example_only": {"type": "boolean"},
    "profile_ref": {"type": "string", "minLength": 1},
    "evidence_index": {"type": "string", "minLength": 1},
    "recorded_at": {"type": "string", "format": "date-time"},
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "observation_id", "category", "qualification", "precondition_eligibility",
          "source", "raw_value", "interpreted_value", "unit", "notes"
        ],
        "properties": {
          "observation_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
          "category": {
            "enum": [
              "IDENTIFICATION", "KL15", "TRANSMISSION_POSITION", "ACTUAL_GEAR",
              "BRAKE", "ENGINE_SPEED", "ENGINE_STATE", "SOURCE_QUALITY"
            ]
          },
          "qualification": {"enum": ["UNKNOWN", "OBSERVED", "CONFIRMED", "UNTRUSTED", "BLOCKED"]},
          "precondition_eligibility": {"enum": ["PROHIBITED", "CANDIDATE"]},
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tool", "sgbd_prg", "job", "field", "physical_context", "observed_at", "session", "evidence_ref"],
            "properties": {
              "tool": {"type": "string", "minLength": 1, "maxLength": 80},
              "sgbd_prg": {"type": ["string", "null"], "maxLength": 120},
              "job": {"type": ["string", "null"], "maxLength": 120},
              "field": {"type": "string", "minLength": 1, "maxLength": 160},
              "physical_context": {"type": "string", "minLength": 1, "maxLength": 500},
              "observed_at": {"type": "string", "format": "date-time"},
              "session": {"type": "string", "minLength": 1, "maxLength": 120},
              "evidence_ref": {"type": "string", "minLength": 1, "maxLength": 96}
            }
          },
          "raw_value": {"type": ["string", "number", "boolean", "null"]},
          "interpreted_value": {"type": ["string", "number", "boolean", "null"]},
          "unit": {"type": ["string", "null"], "maxLength": 32},
          "notes": {"type": ["string", "null"], "maxLength": 2000}
        }
      }
    }
  }
}
