{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bmw-e9x-remote-control.invalid/vehicle-data/schema/synchronized-start-observation.schema.json",
  "title": "Phase 3D synchronized RPM and bitfield observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "timeline_id", "profile_ref", "evidence_index", "evidence_ref",
    "source", "timestamp_basis", "events", "constant_bitfields", "subsequent_rpm_summary",
    "functional_identification"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "timeline_id": {"type": "string", "minLength": 1},
    "profile_ref": {"type": "string", "minLength": 1},
    "evidence_index": {"type": "string", "minLength": 1},
    "evidence_ref": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "sgbd_prg", "job", "session", "observed_at", "physical_context"],
      "properties": {
        "tool": {"type": "string", "minLength": 1},
        "sgbd_prg": {"type": "string", "minLength": 1},
        "job": {"type": "string", "minLength": 1},
        "session": {"type": "string", "minLength": 1},
        "observed_at": {"type": "string", "format": "date-time"},
        "physical_context": {"type": "string", "minLength": 1}
      }
    },
    "timestamp_basis": {"const": "SESSION_RELATIVE"},
    "functional_identification": {"const": "UNKNOWN"},
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "timestamp_us", "event_type", "signal", "qualification", "functional_meaning", "correlation_label", "notes"],
        "properties": {
          "sequence": {"type": "integer", "minimum": 0},
          "timestamp_us": {"type": "integer", "minimum": 0},
          "event_type": {"enum": ["BITFIELD_CHANGE", "RPM_SAMPLE"]},
          "signal": {"type": "string", "minLength": 1},
          "qualification": {"enum": ["OBSERVED", "CONFIRMED"]},
          "functional_meaning": {"type": "null"},
          "correlation_label": {"const": "TEMPORALLY_CORRELATED_WITH_OEM_START"},
          "previous_value": {"$ref": "#/$defs/bitfieldValue"},
          "value": {"$ref": "#/$defs/bitfieldValue"},
          "delta_decimal": {"type": "integer"},
          "changed_bits": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 0, "maximum": 63}},
          "rpm": {"type": "number", "minimum": 0},
          "observed_state": {"enum": ["STOPPED", "CRANKING", "RUNNING", "UNKNOWN"]},
          "notes": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    },
    "constant_bitfields": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["signal", "value", "qualification", "suitability", "functional_meaning", "notes"],
        "properties": {
          "signal": {"type": "string", "minLength": 1},
          "value": {"$ref": "#/$defs/bitfieldValue"},
          "qualification": {"const": "OBSERVED"},
          "suitability": {"const": "OBSERVED_NO_TRANSITION"},
          "functional_meaning": {"type": "null"},
          "notes": {"type": "string", "minLength": 1}
        }
      }
    },
    "subsequent_rpm_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["peak_rpm_approx", "stabilized_rpm_approx", "timestamps_available", "notes"],
      "properties": {
        "peak_rpm_approx": {"type": "number", "minimum": 0},
        "stabilized_rpm_approx": {"type": "number", "minimum": 0},
        "timestamps_available": {"const": false},
        "notes": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "bitfieldValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decimal", "hexadecimal", "binary"],
      "properties": {
        "decimal": {"type": "integer", "minimum": 0},
        "hexadecimal": {"type": "string", "pattern": "^0x[0-9A-F]+$"},
        "binary": {"type": "string", "pattern": "^0b[01]+$"}
      }
    }
  }
}
