{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bmw-e9x-remote-control.invalid/vehicle-data/schema/cas-dde-full-cycle.schema.json",
  "title": "Phase 3D sequential CAS/DDE full-cycle observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_type", "session_id", "observation_id", "profile_ref",
    "evidence_index", "evidence_ref", "source", "source_file", "recovery",
    "signal_inventory", "communication_event", "decoded_klemmenstatus", "user_declared_context",
    "coding_context", "critical_samples", "observed_segments", "transition_bounds",
    "start_summary", "stop_summary", "correlations", "confirmations", "unknowns",
    "causal_inference", "qualification", "forbidden_inferences", "notes"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_type": {"const": "CAS_DDE_FULL_CYCLE_OBSERVATION"},
    "session_id": {"const": "OEM_FULL_CYCLE_01"},
    "observation_id": {"type": "string", "minLength": 1},
    "profile_ref": {"type": "string", "minLength": 1},
    "evidence_index": {"type": "string", "minLength": 1},
    "evidence_ref": {"type": "string", "minLength": 1},
    "source": {"type": "object"},
    "source_file": {"type": "object"},
    "recovery": {"type": "object"},
    "signal_inventory": {"type": "object"},
    "communication_event": {"type": "object"},
    "decoded_klemmenstatus": {"type": "array", "minItems": 4},
    "user_declared_context": {"type": "array", "minItems": 1},
    "coding_context": {"type": "array", "minItems": 1},
    "critical_samples": {"type": "array", "minItems": 12},
    "observed_segments": {"type": "array", "minItems": 5},
    "transition_bounds": {"type": "object"},
    "start_summary": {"type": "object"},
    "stop_summary": {"type": "object"},
    "correlations": {"type": "array", "minItems": 1},
    "confirmations": {"type": "array", "minItems": 1},
    "unknowns": {"type": "array", "minItems": 1},
    "causal_inference": {"const": false},
    "qualification": {"const": "CONFIRMED_AS_SEQUENCE"},
    "forbidden_inferences": {"type": "array", "uniqueItems": true, "minItems": 10},
    "notes": {"type": "string", "minLength": 1}
  }
}
