#pragma once

// BENCH_ONLY: proposed for the reviewed Phase 3B high-speed
// TCAN1057AV + SN74LVC1G125-Q1 bench circuit. GPIO4/5/6/7 were reviewed on the
// initial DevKitC-1-N8 and remain exposed on the current DevKitC-1-N8R8. This
// is not the Phase 3F K-CAN design and is never a BMW wiring recommendation.
// Keep disabled until the electrical checklist starts.
// The copied local file is ignored by Git.
#define BMW_REMOTE_BENCH_ONLY_TWAI_ENABLED 0
#define BMW_REMOTE_BENCH_ONLY_TWAI_RX_GPIO 4
#define BMW_REMOTE_BENCH_ONLY_TWAI_TX_GPIO 5
#define BMW_REMOTE_BENCH_ONLY_SILENT_GPIO 6
#define BMW_REMOTE_BENCH_ONLY_TX_INHIBIT_GPIO 7

// 1 means that a high level holds the corresponding barrier active. Change
// only after checking the selected transceiver and independent TX gate.
#define BMW_REMOTE_BENCH_ONLY_SILENT_LEVEL 1
#define BMW_REMOTE_BENCH_ONLY_TX_INHIBIT_LEVEL 1

// Only 100000 and 500000 are supported in Phase 3.
#define BMW_REMOTE_BENCH_ONLY_BITRATE 100000
#define BMW_REMOTE_BENCH_ONLY_CHANNEL 0
